# Steam Web API Configuration
STEAM_API_KEY=tu_api_key_aqui
RUST_APP_ID=252490

# Rust Log File Paths (Windows default)
RUST_LOG_PATHS=["C:\\Program Files (x86)\\Steam\\steamapps\\common\\Rust\\output_log.txt","C:\\Users\\TU_USUARIO\\AppData\\Local\\Rust\\output_log.txt"]

# Server Query Configuration
QUERY_TIMEOUT=4
QUERY_RETRIES=3

# Modo servidor fijo: IP y puerto del servidor de Rust a monitorizar siempre.
# Déjalo vacío para usar la detección por log local (desarrollo).
TARGET_SERVER_IP=
TARGET_SERVER_PORT=28015

# Backend Server
# Usa 0.0.0.0 si Cloudflare Tunnel u otro cliente se conecta desde internet
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173