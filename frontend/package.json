{
    "name":  "rusty",
    "version":  "1.1.0",
    "private":  true,
    "type":  "module",
    "main":  "electron/main.cjs",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "test:raid":  "node --test src/utils/raidCalculator.test.js",
                    "preview":  "vite preview",
                    "electron:dev":  "concurrently -k \"vite\" \"wait-on tcp:5173 \u0026\u0026 electron .\"",
                    "electron:build":  "npm run build \u0026\u0026 npx electron-builder --publish never"
                },
    "dependencies":  {
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.3.1",
                            "concurrently":  "^8.2.0",
                            "electron":  "^31.3.0",
                            "electron-builder":  "^24.13.3",
                            "three":  "^0.185.1",
                            "vite":  "^5.4.0",
                            "wait-on":  "^7.2.0"
                        },
    "author":  "Rust Tracker",
    "description":  "Rusty electron overlay tracker for Rust game server monitoring and player risk detection.",
    "build":  {
                  "appId":  "com.rusty.app",
                  "productName":  "Rusty",
                  "directories":  {
                                      "output":  "release",
                                      "buildResources":  "build"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "package.json"
                            ],
                  "win":  {
                              "target":  "nsis"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "artifactName":  "Rusty Setup ${version}.exe"
                           }
              }
}
