{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "desktop": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@wonderwhy-er/desktop-commander@latest"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Proyectos\\Rusty",
        "C:\\Users\\duffe"
      ]
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "winremote": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "winremote",
        "--transport",
        "stdio"
      ]
    }
  }
}
