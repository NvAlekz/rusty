{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "desktop": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@wonderwhy-er/desktop-commander@latest"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Proyectos\\Rusty",
        "C:\\Users\\duffe"
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@github/mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "winremote": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "winremote",
        "--transport",
        "stdio"
      ]
    }
  }
}
